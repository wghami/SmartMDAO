# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Custom folders
results/
!results/.keep
.ipynb_checkpoints/

# Coverage cache (regenerated on every pytest run)
.coverage
htmlcov/

# Sync-tool conflict copies (e.g. "file [conflicted].ext").
# The brackets MUST be escaped: unescaped, `[conflicted]` is a glob character
# class matching any one of c,o,n,f,l,i,c,t,e,d - which silently ignores almost
# every file in the repository.
*\[conflicted\]*
